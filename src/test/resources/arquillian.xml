<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<arquillian xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xmlns="http://jboss.org/schema/arquillian"
            xsi:schemaLocation="http://jboss.org/schema/arquillian http://jboss.org/schema/arquillian/arquillian_1_0.xsd">

    <engine>
        <property name="deploymentExportPath">target/</property>
    </engine>

    <container qualifier="wlp-managed" default="true">
        <configuration>
            <property name="wlpHome">${wlp}</property>
            <property name="serverName">${tck_server}</property>
            <property name="httpPort">${tck_port}</property>
            <property name="testProtocol">${tck_protocol}</property>
            <!-- Now that pom.xml only runs liberty:create (not liberty:start)
                 before tests, the server is NOT already running when
                 Arquillian's start() checks for it, so this property's
                 "attach to a running VM" branch is no longer exercised in
                 the normal case. Left as true (harmless) as a safety net in
                 case a server is left running from a previous interrupted
                 run and reused via -Dwlp pointing at an existing install. -->
            <property name="allowConnectingToRunningServer">true</property>
        </configuration>
    </container>
</arquillian>