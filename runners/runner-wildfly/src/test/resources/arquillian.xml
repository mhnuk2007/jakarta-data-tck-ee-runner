<arquillian xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xmlns="http://jboss.org/schema/arquillian"
            xsi:schemaLocation="http://jboss.org/schema/arquillian https://www.jboss.org/schema/arquillian/arquillian_1_0.xsd">
    <defaultProtocol type="Servlet 5.0"/>

    <engine>
        <property name="deploymentExportPath">${project.build.directory}/deployments</property>
    </engine>

    <container qualifier="wildfly-managed" default="true">
        <configuration>
            <property name="jbossHome">${wildfly.home}</property>
            <property name="serverConfig">standalone.xml</property>
            <property name="managementAddress">${tck_hostname}</property>
            <property name="managementPort">${wildfly.management.port}</property>
        </configuration>
    </container>
</arquillian>
