<arquillian xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xmlns="http://jboss.org/schema/arquillian"
            xsi:schemaLocation="http://jboss.org/schema/arquillian https://www.jboss.org/schema/arquillian/arquillian_1_0.xsd">
    <defaultProtocol type="Servlet 6.0"/>

    <engine>
        <property name="deploymentExportPath">${project.build.directory}/deployments</property>
    </engine>

    <container qualifier="glassfish-managed" default="true">
        <configuration>
            <property name="glassFishHome">${glassfish.home}</property>
            <property name="adminHost">${tck_hostname}</property>
            <property name="adminPort">${glassfish.admin.port}</property>
            <property name="httpsPortAsDefault">false</property>
            <property name="enableDerby">true</property>
        </configuration>
    </container>
</arquillian>
